local function UpdateSilentAimTarget()
    if not CheatState.silentAimEnabled then
        CheatState.silentAimTarget = nil
        CheatState.silentAimLookVector = nil
        return
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local closest, minDist = nil, math.huge
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and GetPlayerRole(pl) == "killer" then
            local ch = pl.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local pos = ch and GetTargetAimPoint(ch)
            if hum and hum.Health > 0 and pos then
                local d = (pos - root.Position).Magnitude
                if d < minDist then minDist = d closest = pl end
            end
        end
    end
    if closest and closest.Character then
        local aimPos = GetTargetAimPoint(closest.Character)
        if aimPos and IsWorldPointInScreenRadius(cam, aimPos, Config.silentAimFovRadius) then
            local muzzle = GetMuzzlePos() or cam.CFrame.Position
            local dir = aimPos - muzzle
            if dir.Magnitude > 0.1 then
                CheatState.silentAimTarget = aimPos
                CheatState.silentAimLookVector = dir.Unit
                CheatState.currentMuzzlePos = muzzle
                CheatState.currentTargetPos = aimPos
                return
            end
        end
    end
    CheatState.silentAimTarget = nil
    CheatState.silentAimLookVector = nil
end

local function DrawLaserESP()
    if not CheatState.triggerLaser then return end
    CheatState.triggerLaser = false
    local a, b = CheatState.currentMuzzlePos, CheatState.currentTargetPos
    if typeof(a) ~= "Vector3" or typeof(b) ~= "Vector3" then return end
    local dist = (b - a).Magnitude
    if dist < 0.1 then return end
    local part = Instance.new("Part")
    part.Name = "CigarSilentLaser"
    part.Anchored = true
    part.CanCollide = false
    part.Material = Enum.Material.Neon
    part.Color = Color3.fromRGB(255, 0, 0)
    part.Transparency = 0.3
    part.Size = Vector3.new(0.15, 0.15, dist)
    part.CFrame = CFrame.new(a, b) * CFrame.new(0, 0, -dist / 2)
    part.Parent = Workspace
    task.delay(0.4, function() if part then part:Destroy() end end)
end

-- =======================================================
-- MODULE: SILENT SPEAR
-- =======================================================
local function CalculateSpearFlight(distX, pitch, speed, gravity)
    local cosP = math.cos(pitch)
    if cosP <= 0.015 then return nil end
    local t = distX / (speed * cosP)
    if t ~= t or t <= 0 then return nil end
    local dt = 1/60
    local comp = 0.5 * gravity * dt * t
    local y = speed * math.sin(pitch) * t - 0.5 * gravity * t * t - comp
    return y, t
end

local function SolveSpearTrajectory(origin, targetPos, speed, gravity)
    if speed <= 0 then speed = 142.5 end
    if gravity <= 0 then gravity = 196.2 end
    local offset = targetPos - origin
    local horiz = Vector3.new(offset.X, 0, offset.Z)
    local distX = horiz.Magnitude
    local distY = offset.Y
    if offset.Magnitude <= 0.001 then return nil end
    if distX <= 0.35 or gravity <= 0.001 then
        return offset.Unit, math.clamp(offset.Magnitude / speed, 0.025, 5)
    end
    local hDir = horiz.Unit
    local directPitch = math.atan2(distY, distX)
    local minP = math.max(-Angle28Rad, directPitch - Angle18Rad)
    local maxP = Angle72Rad
    local bestPitch, bestScore, bestDY, bestT = nil, math.huge, math.huge, nil
    local steps = 30
    for i = 0, steps do
        local sp = minP + (maxP - minP) * (i/steps)
        local y, t = CalculateSpearFlight(distX, sp, speed, gravity)
        if y and t and t >= 0.025 and t <= 5 then
            local dy = math.abs(y - distY)
            local score = dy + math.max(sp - Angle42Rad, 0) * 0.35 + math.max(t - 1.3, 0) * 0.25
            if score < bestScore then
                bestScore, bestDY, bestPitch, bestT = score, dy, sp, t
                if dy < MinTargetDiff then break end
            end
        end
    end
    if not bestPitch then
        local t = math.clamp(distX / speed, 0.025, 5)
        local aimPos = targetPos + Vector3.new(0, 0.5 * gravity * t * t, 0)
        local d = aimPos - origin
        if d.Magnitude <= 0.001 then return nil end
        return d.Unit, t
    end
    local dir = hDir * math.cos(bestPitch) + Vector3.new(0, math.sin(bestPitch), 0)
    if dir.Magnitude <= 0.001 then return nil end
    return dir.Unit, bestT
end

