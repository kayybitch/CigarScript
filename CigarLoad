local cachedActionBtn = nil
local instantLastVisible = false
local lastGoalRot = nil
local lastPressTime = 0

local function GetSkillCheckObjects()
    for _, n in ipairs({"SkillCheckPromptGui", "SkillCheckPromptGui-con"}) do
        local gui = PlayerGui:FindFirstChild(n, true)
        if gui then
            local c = gui:FindFirstChild("Check", true)
            if c and c.Visible then
                return c:FindFirstChild("Line", true), c:FindFirstChild("Goal", true)
            end
        end
    end
    return nil, nil
end

local function GetActionButton()
    if cachedActionBtn and cachedActionBtn.Parent and cachedActionBtn:IsA("GuiButton") then return cachedActionBtn end
    cachedActionBtn = nil
    local mob = PlayerGui:FindFirstChild("Survivor-mob", true)
    if not mob then return nil end
    local ctrl = mob:FindFirstChild("Controls", true)
    if not ctrl then return nil end
    local a = ctrl:FindFirstChild("action") or ctrl:FindFirstChild("Gui-mob")
    if a and a:IsA("GuiButton") then cachedActionBtn = a return a end
    return nil
end

local function TriggerSkillCheckHit()
    local btn = GetActionButton()
    if btn then
        if type(firesignal) == "function" then
            local ok = pcall(function()
                firesignal(btn.MouseButton1Down)
                task.delay(0.05, function()
                    if btn and btn.Parent then
                        firesignal(btn.MouseButton1Up)
                        firesignal(btn.MouseButton1Click)
                    end
                end)
            end)
            if ok then return end
        end
        pcall(function()
            local x = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
            local y = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
            task.delay(0.05, function() VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1) end)
        end)
        return
    end
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait()
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
end

local function HandleAutoGenerators()
    if not Config.autoGenerator then return end
    local line, goal = GetSkillCheckObjects()
    if not line or not goal then
        instantLastVisible = false
        lastGoalRot = nil
        return
    end
    local gr = goal.Rotation
    local lr = line.Rotation
    local now = tick()
    if Config.autoGeneratorMode == "Instant" then
        line.Rotation = gr + 109
        if not instantLastVisible or gr ~= lastGoalRot then
            if now - lastPressTime > 0.05 then
                lastGoalRot = gr
                instantLastVisible = true
                lastPressTime = now
                TriggerSkillCheckHit()
            end
        end
    elseif Config.autoGeneratorMode == "Perfect" then
        local diff = (lr - gr) % 360
        if now - lastPressTime > 0.15 and diff >= 102 and diff <= 109 then
            lastPressTime = now
            TriggerSkillCheckHit()
        end
    else
        local diff = (lr - gr) % 360
        if now - lastPressTime > 0.15 and diff >= 125 and diff <= 140 then
            lastPressTime = now
            TriggerSkillCheckHit()
        end
    end
end

