-- =======================================================
local function CheckKillerProximity()
    if not Config.warnEnabled then return end
    local my = LocalPlayer.Character
    local myRoot = my and my:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local nearest = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRole(p) == "killer" then
            local c = p.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if r then
                local d = (r.Position - myRoot.Position).Magnitude
                if d < nearest then nearest = d end
            end
        end
    end
    if nearest <= Config.warnDist3 and CheatState.lastWarnLevel ~= 3 then
        CheatState.lastWarnLevel = 3
        pcall(function() CigarUI:MakeNotify({Title = "KILLER NEARBY", Description = "WARNING", Content = "Very close! (" .. math.floor(nearest) .. "m)", Color = Color3.fromRGB(255, 30, 30), Delay = 3}) end)
    elseif nearest <= Config.warnDist2 and nearest > Config.warnDist3 and CheatState.lastWarnLevel ~= 2 then
        CheatState.lastWarnLevel = 2
        pcall(function() CigarUI:MakeNotify({Title = "KILLER APPROACHING", Description = "WARNING", Content = "Approaching (" .. math.floor(nearest) .. "m)", Color = Color3.fromRGB(255, 150, 0), Delay = 3}) end)
    elseif nearest <= Config.warnDist1 and nearest > Config.warnDist2 and CheatState.lastWarnLevel ~= 1 then
        CheatState.lastWarnLevel = 1
        pcall(function() CigarUI:MakeNotify({Title = "KILLER SPOTTED", Description = "WARNING", Content = "Spotted (" .. math.floor(nearest) .. "m)", Color = Color3.fromRGB(255, 220, 0), Delay = 3}) end)
    elseif nearest > Config.warnDist1 then
        CheatState.lastWarnLevel = 0
    end
end

