-- CROSSHAIR
-- =======================================================
local crosshairTypes = {"Plus", "Cross (X)", "Dot", "Circle", "Circle + Dot", "T-Shape", "Square"}

local function ClearCrosshair(c)
    for _, ch in ipairs(c:GetChildren()) do ch:Destroy() end
    CheatState.crosshairState.Frames = {}
    CheatState.crosshairState.Strokes = {}
    CheatState.crosshairState.DotFrames = {}
end

local function DrawShape(c, sx, sy, len, th, color, op)
    local l = math.max(1, math.round(len * op))
    local t = math.max(1, math.round(th * op))
    local px = math.round(40 + sx * op - l * 0.5)
    local py = math.round(40 + sy * op - t * 0.5)
    local f = Instance.new("Frame")
    f.BackgroundColor3 = color
    f.BackgroundTransparency = 1 - op
    f.BorderSizePixel = 0
    f.Size = UDim2.fromOffset(l, t)
    f.Position = UDim2.fromOffset(px, py)
    f.Parent = c
    table.insert(CheatState.crosshairState.Frames, f)
    return f
end

local function RenderCrosshair(c, style, color, op)
    ClearCrosshair(c)
    local mul = 0.4 + (Config.crosshairSize / 100) * 1.1
    if style == "Plus" then
        DrawShape(c, 0, 0, 19, 3, color, op)
        DrawShape(c, 0, 0, 3, 19, color, op)
        local d = DrawShape(c, 0, 0, 5, 5, Color3.fromRGB(255,255,255), op)
        table.insert(CheatState.crosshairState.DotFrames, d)
    elseif style == "Cross (X)" then
        for _, rot in ipairs({45, -45}) do
            local l = math.max(1, math.round(20 * mul * op))
            local t = math.max(1, math.round(3 * op))
            local f = Instance.new("Frame")
            f.BackgroundColor3 = color
            f.BackgroundTransparency = 1 - op
            f.BorderSizePixel = 0
            f.Size = UDim2.fromOffset(l, t)
            f.Position = UDim2.fromOffset(40 - math.round(l*0.5), 40 - math.round(t*0.5))
            f.Rotation = rot
            f.Parent = c
            table.insert(CheatState.crosshairState.Frames, f)
        end
    elseif style == "Dot" then
        local d = DrawShape(c, 0, 0, 10, 10, color, op)
        local cc = Instance.new("UICorner") cc.CornerRadius = UDim.new(1,0) cc.Parent = d
    elseif style == "Circle" then
        local r = math.max(6, math.round(10 * mul * op))
        local f = Instance.new("Frame")
        f.BackgroundTransparency = 1
        f.Size = UDim2.fromOffset(r*2, r*2)
        f.Position = UDim2.fromOffset(40-r, 40-r)
        f.Parent = c
        local cc = Instance.new("UICorner") cc.CornerRadius = UDim.new(1,0) cc.Parent = f
        local s = Instance.new("UIStroke")
