function Hub.ApplyGhostGateToObj(gate, enable)
    if not gate or not gate.Parent then return end
    local parts = gate:IsA("BasePart") and {gate} or gate:GetDescendants()
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") then
            if enable then
                if not CheatState.ghostGateBackups[part] then
                    CheatState.ghostGateBackups[part] = {CanCollide = part.CanCollide, Transparency = part.Transparency}
                end
                part.CanCollide = false
                part.Transparency = 0.6
            else
                if CheatState.ghostGateBackups[part] then
                    part.CanCollide = CheatState.ghostGateBackups[part].CanCollide
                    part.Transparency = CheatState.ghostGateBackups[part].Transparency
                end
            end
        end
    end
end

function Hub.ApplyGhostGate()
    for _, gate in ipairs(CheatState.cachedMapObjects.Gates) do
        Hub.ApplyGhostGateToObj(gate, CheatState.ghostGateEnabled)
    end
end

function Hub.TeleportToExitGate()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        CigarUI:MakeNotify({Title = "Teleport", Description = "Error", Content = "Character not found!", Color = Color3.fromRGB(255, 80, 80), Delay = 2})
        return
    end
    local nearest, nearestDist = nil, math.huge
    for _, gate in ipairs(CheatState.cachedMapObjects.Gates) do
        if gate and gate.Parent then
            local part = (gate:IsA("Model") and gate.PrimaryPart) or (gate:IsA("BasePart") and gate) or gate:FindFirstChildWhichIsA("BasePart", true)
            if part then
                local d = (part.Position - root.Position).Magnitude
                if d < nearestDist then nearestDist = d nearest = part end
            end
        end
    end
    if not nearest then
        CigarUI:MakeNotify({Title = "Teleport", Description = "Error", Content = "No gates found!", Color = Color3.fromRGB(255, 80, 80), Delay = 2})
        return
    end
    local gatePos = nearest.Position
    local delta = gatePos - root.Position
    local horiz = Vector3.new(delta.X, 0, delta.Z)
    local dir = (horiz.Magnitude > 0.1) and horiz.Unit or nearest.CFrame.LookVector

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char, nearest.Parent}

    local targetPos = nil
    for _, off in ipairs({15, 20, 25, 10}) do
        local start = gatePos + (dir * off) + Vector3.new(0, 10, 0)
        local hit = Workspace:Raycast(start, Vector3.new(0, -30, 0), params)
        if hit then
            local ceil = Workspace:Raycast(hit.Position + Vector3.new(0, 5, 0), Vector3.new(0, 5, 0), params)
            if not ceil then
                targetPos = hit.Position + Vector3.new(0, 3, 0)
                break
            end
        end
    end
    if targetPos then
        pcall(function() root.CFrame = CFrame.new(targetPos) end)
    else
        pcall(function() root.CFrame = CFrame.new(gatePos + Vector3.new(0, 5, 0)) end)
    end
end

