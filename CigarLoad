local function TriggerSkillCheckHit()
    local btn = GetActionButton()
    if btn then
        if type(firesignal) == "function" then
            local ok = pcall(function()
                firesignal(btn.MouseButton1Down)
                task.delay(0.05, function()
                    if btn and btn.Parent then
                        firesignal(btn.MouseButton1Up)
                        firesignal(btn.MouseButton1Click)
                    end
                end)
            end)
            if ok then return end
        end
        pcall(function()
            local x = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
            local y = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
            task.delay(0.05, function() VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1) end)
        end)
        return
    end
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
    task.wait()
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end

local function HandleAutoGenerators()
    if not Config.autoGenerator then return end
    local line, goal = GetSkillCheckObjects()
    if not line or not goal then
        instantLastVisible = false
        lastGoalRot = nil
        return
    end
    local goalRot = goal.Rotation
    local lineRot = line.Rotation
    local now = tick()

    if Config.autoGeneratorMode == "Instant" then
        line.Rotation = goalRot + 109
        if not instantLastVisible or goalRot ~= lastGoalRot then
            if now - lastPressTime > 0.05 then
                lastGoalRot = goalRot
                instantLastVisible = true
                lastPressTime = now
                TriggerSkillCheckHit()
            end
        end
    elseif Config.autoGeneratorMode == "Perfect" then
        local diff = (lineRot - goalRot) % 360
        if now - lastPressTime > 0.15 then
            if diff >= 102 and diff <= 109 then lastPressTime = now TriggerSkillCheckHit() end
        end
    else
        local diff = (lineRot - goalRot) % 360
        if now - lastPressTime > 0.15 then
            if diff >= 125 and diff <= 140 then lastPressTime = now TriggerSkillCheckHit() end
        end
    end
end

