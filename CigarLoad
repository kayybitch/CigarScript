-- MODULE: CAMERA VEIL (LEGIT AIM)
-- =======================================================
local function GetCameraOrigin()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local cam = Workspace.CurrentCamera
    local look = (cam and cam.CFrame.LookVector) or root.CFrame.LookVector
    return root.Position + look * 3 + Vector3.new(0, 1.5, 0)
end

local function GetCharacterPosition(character)
    if not character then return nil end
    local head = character:FindFirstChild("Head")
    if head then return head.Position end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root then return root.Position end
    local up = character:FindFirstChild("UpperTorso")
    if up then return up.Position end
    return character.PrimaryPart and character.PrimaryPart.Position or nil
end

local function GetCharacterVelocity(character)
    if not character then return Vector3.new(0,0,0) end
    local lv = character.AssemblyLinearVelocity
    local v = Vector3.new(lv.X, 0, lv.Z)
    if v.Magnitude > 65 then v = v.Unit * 65 end
    return v
end

local function IsHoldingSpear()
    local char = LocalPlayer.Character
    if not char then return false end
    local ok, val = pcall(char.GetAttribute, char, "spearmode")
    return ok and val == true
end

local function GetClosestTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local camPos, look = cam.CFrame.Position, cam.CFrame.LookVector
    local best, minAngle = nil, Angle30Rad
    local localChar = LocalPlayer.Character
    local root = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and GetPlayerRole(pl) == "survivor" then
            local ch = pl.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if ch and hum and hum.Health > 0 then
                local pos = GetCharacterPosition(ch)
                if pos then
                    local dist = (pos - root.Position).Magnitude
                    if dist <= Config.cameraVeilMaxDistance then
                        local dv = pos - camPos
                        if dv.Magnitude > 0.001 then
                            local angle = math.acos(math.clamp(look:Dot(dv.Unit), -1, 1))
                            if angle < minAngle then minAngle = angle best = pl end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function SolveAimDirection(originPos, targetPos, projSpeed, gravity)
    local offset = targetPos - originPos
    local horiz = Vector3.new(offset.X, 0, offset.Z)
    local distX = horiz.Magnitude
    local distY = offset.Y
    if offset.Magnitude <= 0.001 then return nil end
    if distX <= 0.35 or gravity <= 0.001 then
        return offset.Unit, math.clamp(offset.Magnitude / projSpeed, 0.025, 4)
    end
    local hDir = horiz.Unit
    local directPitch = math.atan2(distY, distX)
    local minPitch = math.max(-Angle28Rad, directPitch - Angle18Rad)
    local maxPitch = Angle72Rad
    local bestPitch, bestScore, bestDeltaY, bestT = nil, math.huge, math.huge, nil
    local steps = 24
    for i = 0, steps do
        local sp = minPitch + (maxPitch - minPitch) * (i/steps)
        local cosP = math.cos(sp)
        if cosP > 0.015 then
            local t = distX / (projSpeed * cosP)
            if t == t and t > 0 and t >= 0.025 and t <= 4 then
                local y = projSpeed * math.sin(sp) * t - 0.5 * gravity * t * t
                local dy = math.abs(y - distY)
                local anglePen = math.max(sp - Angle42Rad, 0) * 0.35
                local timePen = math.max(t - 1.3, 0) * 0.25
                local score = dy + anglePen + timePen
                if score < bestScore then
                    bestScore, bestDeltaY, bestPitch, bestT = score, dy, sp, t
                    if dy < MinTargetDiff then break end
                end
            end
        end
    end
    if not bestPitch then
        local t = math.clamp(distX / projSpeed, 0.025, 4)
        local aimPos = targetPos + Vector3.new(0, 0.5 * gravity * t * t, 0)
        local d = aimPos - originPos
        if d.Magnitude <= 0.001 then return nil end
        return d.Unit, t
    end
    local dir = hDir * math.cos(bestPitch) + Vector3.new(0, math.sin(bestPitch), 0)
    if dir.Magnitude <= 0.001 then return nil end
    return dir.Unit, bestT
end

