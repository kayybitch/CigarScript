-- SILENT SPEAR (guarded hook)
-- =======================================================
local function CalcSpearFlight(dx, pitch, sp, g)
    local cp = math.cos(pitch)
    if cp <= 0.015 then return nil end
    local t = dx / (sp * cp)
    if t ~= t or t <= 0 then return nil end
    local dt = 1/60
    local comp = 0.5 * g * dt * t
    local y = sp * math.sin(pitch) * t - 0.5 * g * t * t - comp
    return y, t
end

local function SolveSpearTrajectory(o, tp, sp, g)
    if sp <= 0 then sp = 142.5 end
    if g <= 0 then g = 196.2 end
    local off = tp - o
    local hor = Vector3.new(off.X, 0, off.Z)
    local dx = hor.Magnitude
    local dy = off.Y
    if off.Magnitude <= 0.001 then return nil end
    if dx <= 0.35 or g <= 0.001 then return off.Unit, math.clamp(off.Magnitude / sp, 0.025, 5) end
    local h = hor.Unit
    local dp = math.atan2(dy, dx)
    local minP = math.max(-Angle28Rad, dp - Angle18Rad)
    local maxP = Angle72Rad
    local bp, bs, bdy, bt = nil, math.huge, math.huge, nil
    for i = 0, 30 do
        local p = minP + (maxP - minP) * (i/30)
        local y, t = CalcSpearFlight(dx, p, sp, g)
        if y and t and t >= 0.025 and t <= 5 then
            local dd = math.abs(y - dy)
            local sc = dd + math.max(p - Angle42Rad, 0) * 0.35 + math.max(t - 1.3, 0) * 0.25
            if sc < bs then bs, bdy, bp, bt = sc, dd, p, t if dd < MinTargetDiff then break end end
        end
    end
    if not bp then
        local t = math.clamp(dx / sp, 0.025, 5)
        local ap = tp + Vector3.new(0, 0.5 * g * t * t, 0)
        local d = ap - o
        if d.Magnitude <= 0.001 then return nil end
        return d.Unit, t
    end
    local dir = h * math.cos(bp) + Vector3.new(0, math.sin(bp), 0)
    if dir.Magnitude <= 0.001 then return nil end
    return dir.Unit, bt
end

local function SetupSilentSpearHook()
    local ok, remote = pcall(function()
        return ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Killers"):WaitForChild("Veil"):WaitForChild("Spearthrow")
    end)
    if not ok or not remote then return false end
    local ok2, err = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            local m = getnamecallmethod()
            if m == "FireServer" and rawequal(self, remote) then
                local a = table.pack(...)
                if CheatState.silentSpearEnabled and typeof(CheatState.silentSpearLookVector) == "Vector3" then
                    if a.n >= 4 and typeof(a[2]) == "Vector3" and typeof(a[4]) == "Vector3" then
                        a[2] = CheatState.silentSpearLookVector
                    end
                end
                return old(self, table.unpack(a, 1, a.n))
            end
            return old(self, ...)
        end)
    end)
    if ok2 then CheatState.modLoaded.silentSpear = true end
    pcall(function()
        local v = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Mechanics"):WaitForChild("visualize")
        v.OnClientEvent:Connect(function(c, _, sp, g)
            if c == LocalPlayer.Character then
                if type(sp) == "number" and sp > 0 then CheatState.lastSpearSpeed = sp end
                if type(g) == "number" and g >= 0 then CheatState.lastGravityMult = g end
            end
        end)
    end)
    return ok2
end

local function UpdateSilentSpear()
    if not CheatState.silentSpearEnabled or not CheatState.modLoaded.silentSpear then
        CheatState.silentSpearLookVector = nil
        return
    end
    local ch = LocalPlayer.Character
    if not ch or not ch:GetAttribute("spearmode") then
        CheatState.silentSpearLookVector = nil
        return
    end
    local r = ch:FindFirstChild("HumanoidRootPart")
    local cam = Workspace.CurrentCamera
    if not r or not cam then return end
    local best, minS = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRole(p) == "survivor" then
            local c = p.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            local pos = c and GetTargetAimPoint(c)
            if h and h.Health > 50 and pos and not c:GetAttribute("IsHooked") then
                local sp, on = cam:WorldToViewportPoint(pos)
                if on then
                    local vp = cam.ViewportSize
                    local center = Vector2.new(vp.X/2, vp.Y/2)
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d <= Config.spearFovRadius and d < minS then minS = d best = p end
                end
            end
        end
    end
    if not best or not best.Character then
        CheatState.silentSpearLookVector = nil
        return
    end
    local tp = GetTargetAimPoint(best.Character)
    local tr = best.Character:FindFirstChild("HumanoidRootPart")
    if not tp or not tr then CheatState.silentSpearLookVector = nil return end
    local o = cam.CFrame.Position
    local sp = 142.5
    if CheatState.spearIsHolding and CheatState.spearHoldStartTime then
        local h = tick() - CheatState.spearHoldStartTime
        if h >= 2 then sp = 165 elseif h >= 1 then sp = 142.5 else sp = math.max(23, h * 150) end
    end
    local g = Workspace.Gravity * (CheatState.lastGravityMult or 1)
    local v = tr.AssemblyLinearVelocity
    local hv = Vector3.new(v.X, 0, v.Z)
    if hv.Magnitude > 65 then hv = hv.Unit * 65 end
    local dir, t = SolveSpearTrajectory(o, tp, sp, g)
    if dir and t then
        local lead = hv * t
        local lp = tp + lead
        local ld, lt = SolveSpearTrajectory(o, lp, sp, g)
        if ld then
            CheatState.silentSpearLookVector = ld
            return
        end
    end
    CheatState.silentSpearLookVector = nil
end

