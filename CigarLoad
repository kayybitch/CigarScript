local function GetPlayerRole(player)
    return CheatState.playerRoles[player] or "survivor"
end

local function UpdatePlayerRole(player)
    local success, teamName = pcall(function()
        return player.Team and player.Team.Name:lower() or ""
    end)
    CheatState.playerRoles[player] = (success and teamName:find("killer")) and "killer" or "survivor"
end

local function GetAttributeOrValue(obj, name)
    if typeof(obj) ~= "Instance" then return nil end
    local attr = obj:GetAttribute(name)
    if attr ~= nil then return attr end
    local child = obj:FindFirstChild(name)
    if child and child:IsA("ValueBase") then return child.Value end
    return nil
end

local function GetCharacterParts(character)
    local parts = {}
    for _, child in ipairs(character:GetDescendants()) do
        if child:IsA("BasePart") and not isFlagSkip[child.Name] and table.find(validPartNames, child.Name) then
            table.insert(parts, child)
        end
    end
    return parts
end

local function GetTargetAimPoint(character)
    if not character then return nil end
    local upperTorso = character:FindFirstChild("UpperTorso")
    if upperTorso and upperTorso:IsA("BasePart") then return upperTorso.Position end
    local torso = character:FindFirstChild("Torso")
    if torso and torso:IsA("BasePart") then return torso.Position end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root then return root.Position + Vector3.new(0, 0.5, 0) end
    return nil
end

local function IsWorldPointInScreenRadius(cam, worldPos, radius)
    if not cam or not worldPos then return false end
    local screenPos, onScreen = cam:WorldToViewportPoint(worldPos)
    if not onScreen then return false end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local sp = Vector2.new(screenPos.X, screenPos.Y)
    return (sp - center).Magnitude <= radius
end

