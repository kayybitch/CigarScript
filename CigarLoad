local function UpdateSilentSpear()
    if not CheatState.silentSpearEnabled then
        CheatState.silentSpearTargetTorso = nil
        CheatState.silentSpearLookVector = nil
        return
    end
    local char = LocalPlayer.Character
    if not char or not char:GetAttribute("spearmode") then
        CheatState.silentSpearTargetTorso = nil
        CheatState.silentSpearLookVector = nil
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    local cam = Workspace.CurrentCamera
    if not root or not cam then return end
    local closest, minScreen = nil, math.huge
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and GetPlayerRole(pl) == "survivor" then
            local ch = pl.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local pos = ch and GetTargetAimPoint(ch)
            if hum and hum.Health > 50 and pos and not ch:GetAttribute("IsHooked") then
                local sp, onScreen = cam:WorldToViewportPoint(pos)
                if onScreen then
                    local vp = cam.ViewportSize
                    local center = Vector2.new(vp.X/2, vp.Y/2)
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d <= Config.spearFovRadius and d < minScreen then
                        minScreen = d closest = pl
                    end
                end
            end
        end
    end
    if not closest or not closest.Character then
        CheatState.silentSpearTargetTorso = nil
        CheatState.silentSpearLookVector = nil
        return
    end
    local targetPos = GetTargetAimPoint(closest.Character)
    local targetRoot = closest.Character:FindFirstChild("HumanoidRootPart")
    if not targetPos or not targetRoot then
        CheatState.silentSpearTargetTorso = nil
        CheatState.silentSpearLookVector = nil
        return
    end
    local origin = cam.CFrame.Position
    local speed = 142.5
    if CheatState.spearIsHolding and CheatState.spearHoldStartTime then
        local held = tick() - CheatState.spearHoldStartTime
        if held >= 2 then speed = 165 elseif held >= 1 then speed = 142.5 else speed = math.max(23, held * 150) end
    end
    local gravity = Workspace.Gravity * (CheatState.lastGravityMult or 1)
    local vel = targetRoot.AssemblyLinearVelocity
    local horizVel = Vector3.new(vel.X, 0, vel.Z)
    if horizVel.Magnitude > 65 then horizVel = horizVel.Unit * 65 end
    local dir, t = SolveSpearTrajectory(origin, targetPos, speed, gravity)
    if dir and t then
        local lead = horizVel * t
        local leadPos = targetPos + lead
        local leadDir, leadT = SolveSpearTrajectory(origin, leadPos, speed, gravity)
        if leadDir then
            CheatState.silentSpearTargetTorso = leadPos
            CheatState.silentSpearLookVector = leadDir
            return
        end
    end
    CheatState.silentSpearTargetTorso = nil
    CheatState.silentSpearLookVector = nil
end

