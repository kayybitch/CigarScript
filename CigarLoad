local function GetActionButton()
    if cachedActionBtn and cachedActionBtn.Parent and cachedActionBtn:IsA("GuiButton") then return cachedActionBtn end
    cachedActionBtn = nil
    local survivorMob = PlayerGui:FindFirstChild("Survivor-mob", true)
    if not survivorMob then return nil end
