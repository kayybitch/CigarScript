local function CreateHighlight(obj, color, fill)
    if not obj or not obj.Parent then return end
    local hl = obj:FindFirstChild("CigarHL")
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "CigarHL"
        hl.Adornee = obj
        hl.FillTransparency = fill or 0.6
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor = color
        hl.OutlineColor = color
        hl.Parent = obj
        return
    end
    hl.FillColor = color
