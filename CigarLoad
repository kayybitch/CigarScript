local accum = {god=0, autoGen=0, silentAim=0, silentSpear=0, laser=0, warn=0, autoParryEsp=0, mapEsp=0, hitboxEsp=0, perf=0}

RunService.Heartbeat:Connect(function(dt)
    accum.god = accum.god + dt
    accum.autoGen = accum.autoGen + dt
    accum.silentAim = accum.silentAim + dt
    accum.silentSpear = accum.silentSpear + dt
    accum.laser = accum.laser + dt
    accum.warn = accum.warn + dt
    accum.autoParryEsp = accum.autoParryEsp + dt
    accum.mapEsp = accum.mapEsp + dt
    accum.hitboxEsp = accum.hitboxEsp + dt
    accum.perf = accum.perf + dt

    if accum.god >= 0.15 then accum.god = 0 pcall(ProcessGodMode) end
    accum.autoGen = 0 pcall(HandleAutoGenerators)
    if accum.silentAim >= 0.05 then accum.silentAim = 0 pcall(UpdateSilentAimTarget) end
    accum.silentSpear = 0 pcall(UpdateSilentSpear)
    accum.laser = 0 pcall(DrawLaserESP)
    if accum.warn >= 0.15 then accum.warn = 0 pcall(CheckKillerProximity) end
    if accum.autoParryEsp >= 0.1 then
        accum.autoParryEsp = 0
        if CheatState.autoParryRadiusEsp then
            pcall(function()
                local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if r and AutoParryState.EspPart and AutoParryState.EspPart.Parent then
                    AutoParryState.EspPart.CFrame = CFrame.new(r.Position)
                end
            end)
        end
    end
    if accum.mapEsp >= 0.2 then accum.mapEsp = 0 pcall(UpdateMapEsp) end
    if accum.hitboxEsp >= 0.15 then
        accum.hitboxEsp = 0
        pcall(function()
            if Config.hitboxEspEnabled then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then SetupHitboxEsp(p, p.Character) end
                end
            else
                for p in pairs(CheatState.hitboxEspObjects) do RemoveHitboxEsp(p) end
            end
        end)
    end
    if accum.perf >= 0.5 then
        accum.perf = 0
        if CheatState.perfEnabled and CheatState.perfGui then
            pcall(function()
                local fps = math.floor(perfFrames / math.max(tick() - perfLastTime, 0.001))
                perfFrames = 0
                perfLastTime = tick()
                local ping = 0
                pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
                local fc = fps >= 50 and "rgb(80,220,100)" or (fps >= 30 and "rgb(255,200,60)" or "rgb(255,70,70)")
                local pc = ping <= 80 and "rgb(80,220,100)" or (ping <= 150 and "rgb(255,200,60)" or "rgb(255,70,70)")
                local f = CheatState.perfGui:FindFirstChild("PerfFrame")
                local l = f and f:FindFirstChild("InfoLabel")
                if l then
                    l.Text = string.format('<font color="%s">FPS %d</font> | <font color="%s">PING %d</font>', fc, fps, pc, ping)
                end
            end)
        end
    end
end)

