local function ProcessGodMode()
    if not CheatState.godEnabled then return end
    local ch = LocalPlayer.Character
    if not ch or not ch.Parent then return end
    local h = ch:FindFirstChildOfClass("Humanoid")
    if not h then return end
    local maxHP = h.MaxHealth
    local hp = h.Health
    if CheatState.godLastHP ~= nil and hp < CheatState.godLastHP and hp > 0 then
        pcall(function() h.Health = maxHP end)
    end
    CheatState.godLastHP = h.Health
    pcall(function()
        local s = h:GetState()
        if s == Enum.HumanoidStateType.Dead then
            h.Health = maxHP
            h:ChangeState(Enum.HumanoidStateType.Running)
            CheatState.godLastHP = maxHP
        elseif s == Enum.HumanoidStateType.Ragdoll or s == Enum.HumanoidStateType.FallingDown then
            h:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
end

