-- MOVEMENT (declare early, used by callbacks)
-- =======================================================
local MovementConns = {antiFall = nil, noSlow = nil}

local function GetModifiedSpeed()
    if Config.speedBoost then
        return DefaultWalkSpeed * (1 + math.clamp(Config.boostPercent, 0, 100) / 100)
    end
    return DefaultWalkSpeed
end

local function EnableAntiFall(hum)
    if MovementConns.antiFall then MovementConns.antiFall:Disconnect() end
    if not hum then return end
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end)
    MovementConns.antiFall = hum.StateChanged:Connect(function(_, s)
        if not Config.antiFallSlow then return end
        if s == Enum.HumanoidStateType.Landed or s == Enum.HumanoidStateType.GettingUp or s == Enum.HumanoidStateType.FallingDown then
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Running)
                hum.WalkSpeed = GetModifiedSpeed()
            end)
        end
    end)
end

local function DisableAntiFall(hum)
    if MovementConns.antiFall then MovementConns.antiFall:Disconnect() MovementConns.antiFall = nil end
    if hum then pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true) end) end
end

local function EnableNoSlowdown(hum)
    if MovementConns.noSlow then MovementConns.noSlow:Disconnect() end
    if not hum or GetPlayerRole(LocalPlayer) == "killer" then return end
    MovementConns.noSlow = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if not Config.noSlowdown or GetPlayerRole(LocalPlayer) == "killer" then return end
        local req = GetModifiedSpeed()
        if hum.WalkSpeed < req - 0.05 then pcall(function() hum.WalkSpeed = req end) end
    end)
end

local function DisableNoSlowdown()
    if MovementConns.noSlow then MovementConns.noSlow:Disconnect() MovementConns.noSlow = nil end
end

