local function UpdateCVSnapLine(targetPos)
    if not Config.cameraVeilSnapLine or not CheatState.CV_Enabled or not IsHoldingSpear() then
        if CheatState.CV_SnapLine then CheatState.CV_SnapLine.Visible = false end
        if CheatState.CV_SnapDot then CheatState.CV_SnapDot.Visible = false end
        return
    end
    CreateCVSnapLine()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local pos = targetPos
    if not pos then
        local closest = GetClosestTarget()
        if closest and closest.Character then pos = GetCharacterPosition(closest.Character) end
    end
    if not pos then
        CheatState.CV_SnapLine.Visible = false
        CheatState.CV_SnapDot.Visible = false
        return
    end
    local screenPos, onScreen = cam:WorldToViewportPoint(pos)
    if not onScreen or screenPos.Z <= 0 then
        CheatState.CV_SnapLine.Visible = false
        CheatState.CV_SnapDot.Visible = false
        return
    end
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    local sp = Vector2.new(screenPos.X, screenPos.Y)
    local delta = sp - center
    local len = delta.Magnitude
    if len < 2 then
        CheatState.CV_SnapLine.Visible = false
        CheatState.CV_SnapDot.Visible = false
        return
    end
    local locked = CheatState.CV_WasHolding and CheatState.CV_CurrentTarget ~= nil
    local color = locked and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(255, 220, 0)
    CheatState.CV_SnapLine.BackgroundColor3 = color
    CheatState.CV_SnapLine.Size = UDim2.fromOffset(len, locked and 2 or 1)
    CheatState.CV_SnapLine.Position = UDim2.fromOffset((center.X + sp.X) * 0.5, (center.Y + sp.Y) * 0.5)
    CheatState.CV_SnapLine.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    CheatState.CV_SnapLine.Visible = true
    CheatState.CV_SnapDot.BackgroundColor3 = color
    CheatState.CV_SnapDot.Position = UDim2.fromOffset(sp.X, sp.Y)
    CheatState.CV_SnapDot.Visible = true
end

local function OnRenderStepAim()
    CheatState.CV_frameCount = CheatState.CV_frameCount + 1
    if not CheatState.CV_Enabled then return end
    local holding = CheatState.CV_HoldingPC or CheatState.CV_HoldingMobile
    if not holding then
        if CheatState.CV_WasHolding then
            CheatState.CV_CurrentTarget = nil
            CheatState.CV_WasHolding = false
            CheatState.CV_LastStableDir = nil
            CheatState.CV_acquireStartFrame = nil
        end
        UpdateCVSnapLine(nil)
        return
    end
    if not CheatState.CV_WasHolding then
        CheatState.CV_LastStableDir = nil
        CheatState.CV_CurrentTarget = GetClosestTarget()
        CheatState.CV_WasHolding = true
        CheatState.CV_acquireStartFrame = CheatState.CV_frameCount
    end
    local target = CheatState.CV_CurrentTarget
    if not target then
        CheatState.CV_WasHolding = false
        return
    end
    local ch = target.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not ch or not hum or hum.Health <= 0 or GetPlayerRole(target) ~= "survivor" then
        CheatState.CV_WasHolding = false
        CheatState.CV_CurrentTarget = nil
        return
    end
    local pos = GetCharacterPosition(ch)
    if not pos then
        CheatState.CV_WasHolding = false
        CheatState.CV_CurrentTarget = nil
        return
    end
    local cam = Workspace.CurrentCamera
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not cam or not localRoot then return end
    if (pos - localRoot.Position).Magnitude > Config.cameraVeilMaxDistance then
        CheatState.CV_WasHolding = false
        CheatState.CV_CurrentTarget = nil
        return
    end
    local vel = GetCharacterVelocity(ch:FindFirstChild("HumanoidRootPart"))
    local origin = GetCameraOrigin()
    if not origin then return end
    local speed = tonumber(CheatState.CV_LastSpearSpeed) or tonumber(Config.cameraVeilSpearSpeed) or 220
    speed = math.clamp(speed, 35, 800)
    local gravityMult = math.max(tonumber(CheatState.CV_LastGravityMult) or 1, 0)
    local gravity = Workspace.Gravity * gravityMult
    local aimDir, flightT = SolveAimDirection(origin, pos, speed, gravity)
    if aimDir and flightT and vel.Magnitude > 1.25 then
        local leadScale = math.clamp(flightT * 0.68, 0, 1.1)
        local lead = vel * leadScale
        if lead.Magnitude > 32 then lead = lead.Unit * 32 end
        local refined, refinedT = SolveAimDirection(origin, pos + lead, speed, gravity)
        if refined then aimDir, flightT = refined, refinedT end
    end
    local stableDir = aimDir
    if stableDir and stableDir.Y < 0.95 and stableDir.Y > -0.95 then
        if CheatState.CV_LastStableDir then
            local diff = math.acos(math.clamp(CheatState.CV_LastStableDir:Dot(stableDir), -1, 1))
            if diff < Angle45Rad then CheatState.CV_LastStableDir = stableDir end
        else
            CheatState.CV_LastStableDir = stableDir
        end
        stableDir = CheatState.CV_LastStableDir
    elseif CheatState.CV_LastStableDir then
        stableDir = CheatState.CV_LastStableDir
    else
        stableDir = cam.CFrame.LookVector
    end
    local camPos = cam.CFrame.Position
    local smooth = math.clamp(Config.cameraVeilSmoothness or 1, 0.05, 1)
    local newLook = cam.CFrame.LookVector:Lerp(stableDir, smooth)
    if newLook.Magnitude > 0.001 then
        cam.CFrame = CFrame.new(camPos, camPos + newLook.Unit)
        UpdateCVSnapLine(pos)
    end
end

