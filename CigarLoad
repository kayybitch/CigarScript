local function GetPlayerRole(player)
    return CheatState.playerRoles[player] or "survivor"
end

local function UpdatePlayerRole(player)
    local ok, teamName = pcall(function()
        return player.Team and player.Team.Name:lower() or ""
    end)
    CheatState.playerRoles[player] = (ok and teamName:find("killer")) and "killer" or "survivor"
end

local function GetAttributeOrValue(obj, name)
    if typeof(obj) ~= "Instance" then return nil end
    local a = obj:GetAttribute(name)
    if a ~= nil then return a end
    local c = obj:FindFirstChild(name)
    if c and c:IsA("ValueBase") then return c.Value end
    return nil
end

local function GetCharacterParts(character)
    local parts = {}
    for _, child in ipairs(character:GetDescendants()) do
        if child:IsA("BasePart") and not isFlagSkip[child.Name] and table.find(validPartNames, child.Name) then
            table.insert(parts, child)
        end
    end
    return parts
end

local function GetTargetAimPoint(character)
    if not character then return nil end
    local ut = character:FindFirstChild("UpperTorso")
    if ut and ut:IsA("BasePart") then return ut.Position end
    local t = character:FindFirstChild("Torso")
    if t and t:IsA("BasePart") then return t.Position end
    local r = character:FindFirstChild("HumanoidRootPart")
    if r then return r.Position + Vector3.new(0, 0.5, 0) end
    return nil
end

local function IsWorldPointInScreenRadius(cam, worldPos, radius)
    if not cam or not worldPos then return false end
    local sp, on = cam:WorldToViewportPoint(worldPos)
    if not on then return false end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    return (Vector2.new(sp.X, sp.Y) - center).Magnitude <= radius
end

