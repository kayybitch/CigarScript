-- AUTO PARRY
-- =======================================================
local AutoParryState = {
    Enabled = false, Cooldown = false, COOLDOWN_TIME = 1.0, KillerConns = {},
    EspPart = nil, EspFolder = nil, HOLD_TIME = 0.06,
    CachedBtn = nil, KillerBlacklist = {}, BLACKLIST_DURATION = 2.5
}

local function IsParriableAnim(track)
    local anim = track.Animation
    if not anim then return false end
    local n = anim.Name
    if n then
        local lower = n:lower():gsub("%s+", "")
        for _, k in ipairs(killerAnims) do
            if lower == k then return true end
        end
    end
    return false
end

function Hub.IsPlayerInParryRange(char)
    local my = LocalPlayer.Character
    local myRoot = my and my:FindFirstChild("HumanoidRootPart")
    local kRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot or not kRoot then return false end
    return (kRoot.Position - myRoot.Position).Magnitude <= CheatState.autoParryRadius
end

function Hub.IsTargetFacingMe(char)
    local my = LocalPlayer.Character
    local myRoot = my and my:FindFirstChild("HumanoidRootPart")
    local kRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot or not kRoot then return false end
    return kRoot.CFrame.LookVector:Dot((myRoot.Position - kRoot.Position).Unit) > 0.46
end

function Hub.GetParryButton()
    if AutoParryState.CachedBtn and AutoParryState.CachedBtn.Parent and AutoParryState.CachedBtn.Visible then
        return AutoParryState.CachedBtn
    end
    local mob = PlayerGui:FindFirstChild("Survivor-mob", true)
    if not mob then return nil end
    local ctrl = mob:FindFirstChild("Controls", true)
    if not ctrl then return nil end
    local btn = ctrl:FindFirstChild("Gui-mob")
    if btn and btn:IsA("ImageButton") and btn.Visible then
        AutoParryState.CachedBtn = btn
        return btn
    end
    return nil
end

function Hub.TriggerParry()
    local btn = Hub.GetParryButton()
    if btn and type(firesignal) == "function" then
        pcall(function()
            firesignal(btn.MouseButton1Down)
            task.delay(AutoParryState.HOLD_TIME, function()
                if btn and btn.Parent then
                    firesignal(btn.MouseButton1Up)
                    firesignal(btn.MouseButton1Click)
                end
            end)
        end)
        return true
    end
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 1, true, game, 1)
        task.delay(AutoParryState.HOLD_TIME, function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 1, false, game, 1)
        end)
    end)
    return false
end

function Hub.ParryAttack(hum)
    if AutoParryState.Cooldown then return end
    AutoParryState.Cooldown = true
    if hum then AutoParryState.KillerBlacklist[hum] = tick() end
    Hub.TriggerParry()
    task.delay(AutoParryState.COOLDOWN_TIME, function() AutoParryState.Cooldown = false end)
end

function Hub.TrackKillerAnimations(player, char)
    if player == LocalPlayer then return end
    UpdatePlayerRole(player)
    if GetPlayerRole(player) ~= "killer" then return end
    char = char or player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or AutoParryState.KillerConns[hum] then return end
    local conn = hum.AnimationPlayed:Connect(function(track)
        pcall(function()
            if not CheatState.autoParryEnabled then return end
            if not IsParriableAnim(track) then return end
            if not Hub.IsPlayerInParryRange(char) then return end
            if not Hub.IsTargetFacingMe(char) then return end
            local lastBl = AutoParryState.KillerBlacklist[hum]
            if lastBl and (tick() - lastBl) < AutoParryState.BLACKLIST_DURATION then return end
            Hub.ParryAttack(hum)
        end)
    end)
    AutoParryState.KillerConns[hum] = conn
end

function Hub.EnableAutoParry()
    CheatState.autoParryEnabled = true
    AutoParryState.Enabled = true
    for _, p in ipairs(Players:GetPlayers()) do
        pcall(function() Hub.TrackKillerAnimations(p) end)
    end
end

function Hub.DisableAutoParry()
    CheatState.autoParryEnabled = false
    AutoParryState.Enabled = false
    for _, c in pairs(AutoParryState.KillerConns) do pcall(function() c:Disconnect() end) end
    AutoParryState.KillerConns = {}
end

function Hub.ClearAutoParryEsp()
    if AutoParryState.EspFolder then pcall(function() AutoParryState.EspFolder:Destroy() end) AutoParryState.EspFolder = nil end
    for _, f in ipairs(Workspace:GetChildren()) do
        if f.Name == "AutoParryRadiusESP" then pcall(function() f:Destroy() end) end
    end
    AutoParryState.EspPart = nil
end

function Hub.DrawAutoParryEsp()
    Hub.ClearAutoParryEsp()
    local folder = Instance.new("Folder")
    folder.Name = "AutoParryRadiusESP"
    folder.Parent = Workspace
    local center = Instance.new("Part")
    center.Name = "RadiusESP_Center"
    center.Anchored = true
    center.CanCollide = false
    center.Transparency = 1
    center.Size = Vector3.new(0.2, 0.2, 0.2)
    center.Parent = folder
    local pts = 36
    local radius = CheatState.autoParryRadius
    local atts = {}
    for i = 1, pts do
        local angle = (math.pi * 2 / pts) * i
        local a = Instance.new("Attachment")
        a.Position = Vector3.new(math.cos(angle) * radius, -2.5, math.sin(angle) * radius)
        a.Parent = center
        atts[i] = a
    end
    for i = 1, pts do
        local nxt = (i % pts) + 1
        local b = Instance.new("Beam")
        b.Attachment0 = atts[i]
        b.Attachment1 = atts[nxt]
        b.Width0 = 0.15
        b.Width1 = 0.15
        b.Color = ColorSequence.new(Color3.fromRGB(255, 60, 60))
        b.LightEmission = 1
        b.FaceCamera = false
        b.Parent = center
    end
    AutoParryState.EspFolder = folder
    AutoParryState.EspPart = center
end

