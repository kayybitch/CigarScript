local crosshairTypes = {"Plus", "Cross (X)", "Dot", "Circle", "Circle + Dot", "T-Shape", "Square"}

local function ClearCrosshair(container)
    for _, child in ipairs(container:GetChildren()) do child:Destroy() end
    CheatState.crosshairState.Frames = {}
    CheatState.crosshairState.Strokes = {}
    CheatState.crosshairState.DotFrames = {}
end

local function DrawCrosshairShape(container, sx, sy, length, thickness, color, opacity)
    local len = math.max(1, math.round(length * opacity))
    local th = math.max(1, math.round(thickness * opacity))
    local px = math.round(40 + sx * opacity - len * 0.5)
    local py = math.round(40 + sy * opacity - th * 0.5)
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = color
    frame.BackgroundTransparency = 1 - opacity
    frame.BorderSizePixel = 0
    frame.Size = UDim2.fromOffset(len, th)
    frame.Position = UDim2.fromOffset(px, py)
    frame.Parent = container
    table.insert(CheatState.crosshairState.Frames, frame)
    return frame
end

local function RenderCrosshair(container, style, color, opacity)
    if container:FindFirstChildOfClass("Frame") then
        ClearCrosshair(container)
    end
    local sizeMul = 0.4 + (Config.crosshairSize / 100) * 1.1
    if style == "Plus" then
        DrawCrosshairShape(container, 0, 0, 8*2+3, 3, color, opacity)
        DrawCrosshairShape(container, 0, 0, 3, 8*2+3, color, opacity)
        local dot = DrawCrosshairShape(container, 0, 0, 5, 5, Color3.fromRGB(255,255,255), opacity)
        table.insert(CheatState.crosshairState.DotFrames, dot)
    elseif style == "Cross (X)" then
        for _, rot in ipairs({45, -45}) do
            local len = math.max(1, math.round(20 * sizeMul * opacity))
            local th = math.max(1, math.round(3 * opacity))
            local frame = Instance.new("Frame")
            frame.BackgroundColor3 = color
            frame.BackgroundTransparency = 1 - opacity
            frame.BorderSizePixel = 0
            frame.Size = UDim2.fromOffset(len, th)
            frame.Position = UDim2.fromOffset(40 - math.round(len*0.5), 40 - math.round(th*0.5))
            frame.Rotation = rot
            frame.Parent = container
            table.insert(CheatState.crosshairState.Frames, frame)
        end
    elseif style == "Dot" then
        local dot = DrawCrosshairShape(container, 0, 0, 10, 10, color, opacity)
        local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1,0) c.Parent = dot
    elseif style == "Circle" then
        local r = math.max(6, math.round(10 * sizeMul * opacity))
        local frame = Instance.new("Frame")
        frame.BackgroundTransparency = 1
        frame.Size = UDim2.fromOffset(r*2, r*2)
        frame.Position = UDim2.fromOffset(40-r, 40-r)
        frame.Parent = container
        local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1,0) c.Parent = frame
        local s = Instance.new("UIStroke")
        s.Color = color s.Thickness = math.max(2, math.round(2.5*opacity)) s.Transparency = 1-opacity
        s.Parent = frame
        table.insert(CheatState.crosshairState.Strokes, s)
    elseif style == "Circle + Dot" then
        local r = math.max(6, math.round(10 * sizeMul * opacity))
        local frame = Instance.new("Frame")
        frame.BackgroundTransparency = 1
        frame.Size = UDim2.fromOffset(r*2, r*2)
        frame.Position = UDim2.fromOffset(40-r, 40-r)
        frame.Parent = container
        local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1,0) c.Parent = frame
        local s = Instance.new("UIStroke")
        s.Color = color s.Thickness = math.max(2, math.round(2.5*opacity)) s.Transparency = 1-opacity
        s.Parent = frame
        table.insert(CheatState.crosshairState.Strokes, s)
        local dot = DrawCrosshairShape(container, 0, 0, 6, 6, color, opacity)
        local c2 = Instance.new("UICorner") c2.CornerRadius = UDim.new(1,0) c2.Parent = dot
    elseif style == "T-Shape" then
        DrawCrosshairShape(container, 0, -4, 3, 8, color, opacity)
        DrawCrosshairShape(container, 0, 0, 8*2+3, 3, color, opacity)
    elseif style == "Square" then
        local off, len, th = 10, 6, 3
        DrawCrosshairShape(container, -(off-len*0.5), -off, len, th, color, opacity)
        DrawCrosshairShape(container, -off, -(off-len*0.5), th, len, color, opacity)
        DrawCrosshairShape(container, (off-len*0.5), -off, len, th, color, opacity)
        DrawCrosshairShape(container, off, -(off-len*0.5), th, len, color, opacity)
        DrawCrosshairShape(container, -(off-len*0.5), off, len, th, color, opacity)
        DrawCrosshairShape(container, -off, (off-len*0.5), th, len, color, opacity)
        DrawCrosshairShape(container, (off-len*0.5), off, len, th, color, opacity)
        DrawCrosshairShape(container, off, (off-len*0.5), th, len, color, opacity)
    end
end

