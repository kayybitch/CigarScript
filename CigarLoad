local function UpdateGeneratorEsp(gen)
    if not gen or not gen.Parent then return true end
    if CheatState.completedGenerators[gen] then return true end
    local progress = GetAttributeOrValue(gen, "RepairProgress") or GetAttributeOrValue(gen, "Progress") or 0
    local done = (progress >= 100) or (GetAttributeOrValue(gen, "Completed") == true) or (GetAttributeOrValue(gen, "IsCompleted") == true) or (GetAttributeOrValue(gen, "Done") == true)
    local bb = gen:FindFirstChild("CigarGenProgress")
    if done or not Config.espGeneratorEnabled then
        if bb then bb:Destroy() end
        RemoveHighlight(gen)
        gen:SetAttribute("CigarGenLastPct", nil)
        if done then CheatState.completedGenerators[gen] = true end
        return done
    end
    CreateHighlight(gen, Config.espGeneratorColor, 0.6)
    if Config.espGeneratorProgressGen then
        local pct = math.floor(progress + 0.5)
        if gen:GetAttribute("CigarGenLastPct") == pct and bb then return false end
        gen:SetAttribute("CigarGenLastPct", pct)
        local c = math.clamp(progress, 0, 100)
        local color = (c < 50) and Config.espGeneratorColor:Lerp(Color3.fromRGB(255, 200, 0), c/50) or Color3.fromRGB(255, 200, 0):Lerp(Color3.fromRGB(100, 255, 80), (c-50)/50)
        local txt = string.format("%d%%", pct)
        local main = gen:FindFirstChild("defaultMaterial", true) or (gen:IsA("Model") and gen.PrimaryPart) or gen:FindFirstChildWhichIsA("BasePart", true)
        if not main then return false end
        if not bb then
            bb = Instance.new("BillboardGui")
            bb.Name = "CigarGenProgress"
            bb.Adornee = main
            bb.AlwaysOnTop = true
            bb.LightInfluence = 0
            bb.ResetOnSpawn = false
            bb.MaxDistance = 260
            bb.Size = UDim2.new(0, 160, 0, 36)
            bb.StudsOffset = Vector3.new(0, 1.95, 0)
            bb.Parent = gen
            local l = Instance.new("TextLabel")
            l.Name = "Label"
            l.BackgroundTransparency = 1
            l.Size = UDim2.fromScale(1, 1)
            l.Font = Enum.Font.GothamBold
            l.TextSize = 16
            l.Text = txt
            l.TextColor3 = color
            l.TextStrokeTransparency = 0
            l.Parent = bb
            local s = Instance.new("UIStroke")
            s.Thickness = 1.5
            s.Transparency = 0.15
            s.Color = Color3.new(0, 0, 0)
            s.Parent = l
        else
            local l = bb:FindFirstChild("Label")
            if l then l.Text = txt l.TextColor3 = color end
        end
    else
        if bb then bb:Destroy() gen:SetAttribute("CigarGenLastPct", nil) end
    end
    return false
end

local function MonitorGeneratorProgress(gen)
    local function u() if not Config.espGeneratorEnabled then return end UpdateGeneratorEsp(gen) end
    pcall(function()
        gen:GetAttributeChangedSignal("RepairProgress"):Connect(u)
        gen:GetAttributeChangedSignal("Progress"):Connect(u)
        gen:GetAttributeChangedSignal("Completed"):Connect(u)
        gen:GetAttributeChangedSignal("IsCompleted"):Connect(u)
    end)
    gen.ChildAdded:Connect(function(c)
        if c.Name == "RepairProgress" or c.Name == "Progress" or c.Name == "Completed" or c.Name == "IsCompleted" then
            if c:IsA("ValueBase") then c.Changed:Connect(u) end
            u()
        end
    end)
end

local function MonitorPalletState(pallet, meta)
    local function u()
        local d = GetAttributeOrValue(pallet, "Dropped") or GetAttributeOrValue(pallet, "IsDropped")
        local b = GetAttributeOrValue(pallet, "Broken") or GetAttributeOrValue(pallet, "IsBroken") or GetAttributeOrValue(pallet, "Destroyed")
        if d or b or meta.isFake then
            RemoveHighlight(pallet)
            for i, p in ipairs(CheatState.cachedMapObjects.Pallets) do
                if p == pallet then table.remove(CheatState.cachedMapObjects.Pallets, i) break end
            end
            CheatState.cachedPalletMeta[pallet] = nil
        end
    end
    for _, n in ipairs({"Dropped", "IsDropped", "Broken", "IsBroken", "Destroyed"}) do
        pcall(function() pallet:GetAttributeChangedSignal(n):Connect(u) end)
    end
end

local function OnMapObjectAdded(obj)
    local n = obj.Name
    if n == "Generator" then
        table.insert(CheatState.cachedMapObjects.Generators, obj)
        if Config.espGeneratorEnabled then UpdateGeneratorEsp(obj) MonitorGeneratorProgress(obj) end
    elseif n == "Hook" then
        table.insert(CheatState.cachedMapObjects.Hooks, obj)
        local mesh = {}
        local m = obj:FindFirstChild("Model")
        if m then for _, c in ipairs(m:GetDescendants()) do if c:IsA("MeshPart") then table.insert(mesh, c) end end end
        CheatState.cachedHookMeshParts[obj] = mesh
        if Config.espHookEnabled then
            if #mesh > 0 then for _, mp in ipairs(mesh) do CreateHighlight(mp, Config.espHookColor, 0.6) end
            else CreateHighlight(obj, Config.espHookColor, 0.6) end
        end
    elseif n == "Gate" then
        table.insert(CheatState.cachedMapObjects.Gates, obj)
        if Config.espGateEnabled then CreateHighlight(obj, Config.espGateColor, 0.6) end
        if CheatState.ghostGateEnabled then Hub.ApplyGhostGateToObj(obj, true) end
    elseif n == "Pallet" or n == "Palletwrong" then
        table.insert(CheatState.cachedMapObjects.Pallets, obj)
        local lower = n:lower()
        local part = (obj:IsA("Model") and obj.PrimaryPart) or obj:FindFirstChildWhichIsA("BasePart", true) or (obj:IsA("BasePart") and obj)
        local fake = lower:find("fake") or lower:find("broken") or lower:find("destroyed")
        local meta = {part = part, isFake = fake and true or false}
        CheatState.cachedPalletMeta[obj] = meta
        if Config.espPalletEnabled and not meta.isFake then CreateHighlight(obj, Config.espPalletColor, 0.6) end
        MonitorPalletState(obj, meta)
    end
end

local function OnMapObjectRemoved(obj)
    local n = obj.Name
    if n == "Generator" then
        for i, g in ipairs(CheatState.cachedMapObjects.Generators) do if g == obj then table.remove(CheatState.cachedMapObjects.Generators, i) break end end
        CheatState.completedGenerators[obj] = nil
        RemoveHighlight(obj)
        local bb = obj:FindFirstChild("CigarGenProgress") if bb then bb:Destroy() end
    elseif n == "Hook" then
        for i, h in ipairs(CheatState.cachedMapObjects.Hooks) do if h == obj then table.remove(CheatState.cachedMapObjects.Hooks, i) break end end
        local mesh = CheatState.cachedHookMeshParts[obj]
        if mesh then for _, mp in ipairs(mesh) do RemoveHighlight(mp) end else RemoveHighlight(obj) end
        CheatState.cachedHookMeshParts[obj] = nil
    elseif n == "Gate" then
        for i, g in ipairs(CheatState.cachedMapObjects.Gates) do if g == obj then table.remove(CheatState.cachedMapObjects.Gates, i) break end end
        RemoveHighlight(obj)
    elseif n == "Pallet" or n == "Palletwrong" then
        for i, p in ipairs(CheatState.cachedMapObjects.Pallets) do if p == obj then table.remove(CheatState.cachedMapObjects.Pallets, i) break end end
        RemoveHighlight(obj)
        CheatState.cachedPalletMeta[obj] = nil
    end
end

local function InitializeMapEsp(map)
    if not map then return end
    CheatState.cachedMapObjects = {Generators = {}, Pallets = {}, Hooks = {}, Gates = {}}
    CheatState.cachedPalletMeta = {}
    CheatState.cachedHookMeshParts = {}
    CheatState.completedGenerators = {}
    for _, d in ipairs(map:GetDescendants()) do OnMapObjectAdded(d) end
    map.DescendantAdded:Connect(OnMapObjectAdded)
    map.DescendantRemoving:Connect(OnMapObjectRemoved)
    CheatState.objEspInitialized = true
end

local mapObj = Workspace:FindFirstChild("Map")
if mapObj then pcall(InitializeMapEsp, mapObj) end
Workspace.ChildAdded:Connect(function(c) if c.Name == "Map" then task.wait(2) pcall(InitializeMapEsp, c) end end)
Workspace.ChildRemoved:Connect(function(c)
    if c.Name == "Map" then
        CheatState.cachedMapObjects = {Generators = {}, Pallets = {}, Hooks = {}, Gates = {}}
        CheatState.cachedPalletMeta = {}
        CheatState.cachedHookMeshParts = {}
        CheatState.completedGenerators = {}
        CheatState.objEspInitialized = false
    end
end)

local function UpdateMapEsp()
    if not CheatState.objEspInitialized then return end
    if Config.espGeneratorEnabled then
        local valid = {}
        for _, g in ipairs(CheatState.cachedMapObjects.Generators) do
            if g and g.Parent then
                local done = UpdateGeneratorEsp(g)
                if not done then table.insert(valid, g) end
            end
        end
        CheatState.cachedMapObjects.Generators = valid
    else
        for _, g in ipairs(CheatState.cachedMapObjects.Generators) do
            if g and g.Parent then
                RemoveHighlight(g)
                local bb = g:FindFirstChild("CigarGenProgress") if bb then bb:Destroy() end
                g:SetAttribute("CigarGenLastPct", nil)
            end
        end
    end
    if Config.espPalletEnabled then
        for _, p in ipairs(CheatState.cachedMapObjects.Pallets) do
            if p and p.Parent then
                local m = CheatState.cachedPalletMeta[p]
                if m and not m.isFake then CreateHighlight(p, Config.espPalletColor, 0.6) end
            end
        end
    else
        for _, p in ipairs(CheatState.cachedMapObjects.Pallets) do if p then RemoveHighlight(p) end end
    end
    if Config.espHookEnabled then
        for _, h in ipairs(CheatState.cachedMapObjects.Hooks) do
            if h and h.Parent then
                local mesh = CheatState.cachedHookMeshParts[h]
                if mesh and #mesh > 0 then for _, mp in ipairs(mesh) do CreateHighlight(mp, Config.espHookColor, 0.6) end
                else CreateHighlight(h, Config.espHookColor, 0.6) end
            end
        end
    else
        for _, h in ipairs(CheatState.cachedMapObjects.Hooks) do
            if h and h.Parent then
                local mesh = CheatState.cachedHookMeshParts[h]
                if mesh then for _, mp in ipairs(mesh) do RemoveHighlight(mp) end else RemoveHighlight(h) end
            end
        end
    end
    if Config.espGateEnabled then
        for _, g in ipairs(CheatState.cachedMapObjects.Gates) do if g and g.Parent then CreateHighlight(g, Config.espGateColor, 0.6) end end
    else
        for _, g in ipairs(CheatState.cachedMapObjects.Gates) do if g and g.Parent then RemoveHighlight(g) end end
    end
end

