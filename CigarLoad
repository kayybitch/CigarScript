-- =======================================================
local function CheckKillerProximity()
    if not Config.warnEnabled then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local nearest = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and GetPlayerRole(player) == "killer" then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < nearest then nearest = d end
            end
        end
    end
    if nearest <= Config.warnDist3 and CheatState.lastWarnLevel ~= 3 then
        CheatState.lastWarnLevel = 3
        CigarUI:MakeNotify({Title = "KILLER NEARBY", Description = "WARNING", Content = "Very close! (" .. math.floor(nearest) .. "m)", Color = Color3.fromRGB(255, 30, 30), Delay = 3})
    elseif nearest <= Config.warnDist2 and nearest > Config.warnDist3 and CheatState.lastWarnLevel ~= 2 then
        CheatState.lastWarnLevel = 2
        CigarUI:MakeNotify({Title = "KILLER APPROACHING", Description = "WARNING", Content = "Approaching (" .. math.floor(nearest) .. "m)", Color = Color3.fromRGB(255, 150, 0), Delay = 3})
    elseif nearest <= Config.warnDist1 and nearest > Config.warnDist2 and CheatState.lastWarnLevel ~= 1 then
        CheatState.lastWarnLevel = 1
        CigarUI:MakeNotify({Title = "KILLER SPOTTED", Description = "WARNING", Content = "Spotted (" .. math.floor(nearest) .. "m)", Color = Color3.fromRGB(255, 220, 0), Delay = 3})
    elseif nearest > Config.warnDist1 then
        CheatState.lastWarnLevel = 0
    end
end

