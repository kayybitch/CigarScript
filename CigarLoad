local function CreateHighlight(obj, color, fillTrans)
    if not obj or not obj.Parent then return end
    local hl = obj:FindFirstChild("CigarHL")
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "CigarHL"
        hl.Adornee = obj
        hl.FillTransparency = fillTrans or 0.6
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor = color
        hl.OutlineColor = color
        hl.Parent = obj
        return
    end
    if hl.FillColor ~= color then hl.FillColor = color hl.OutlineColor = color end
    hl.FillTransparency = fillTrans or 0.6
    hl.Enabled = true
end

local function RemoveHighlight(obj)
    if not obj then return end
    local hl = obj:FindFirstChild("CigarHL")
    if hl then pcall(function() hl:Destroy() end) end
end

local function UpdateOutline(player, character)
    local hl = CheatState.outlineObjects[player]
    if not hl then return end
    local role = GetPlayerRole(player)
    local isKiller = (role == "killer")
    local color = isKiller and Config.killerColor or Config.survivorColor
    local showOutline = isKiller and Config.killerShowOutline or Config.survivorShowOutline
    local outlineOnly = isKiller and Config.killerOutlineOnly or Config.survivorOutlineOnly
    local enabled = isKiller and Config.espKiller or Config.espSurvivors

    hl.Adornee = character
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = outlineOnly and 1 or Config.fillTransparency
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = enabled and showOutline
end

