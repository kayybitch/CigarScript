local function GetClosestTarget()
    local c = Workspace.CurrentCamera
    if not c then return nil end
    local cp, look = c.CFrame.Position, c.CFrame.LookVector
    local best, minA = nil, Angle30Rad
    local my = LocalPlayer.Character
    local r = my and my:FindFirstChild("HumanoidRootPart")
    if not r then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRole(p) == "survivor" then
            local ch = p.Character
            local h = ch and ch:FindFirstChildOfClass("Humanoid")
            if ch and h and h.Health > 0 then
                local pos = GetCharPos(ch)
                if pos and (pos - r.Position).Magnitude <= Config.cameraVeilMaxDistance then
                    local dv = pos - cp
                    if dv.Magnitude > 0.001 then
                        local a = math.acos(math.clamp(look:Dot(dv.Unit), -1, 1))
                        if a < minA then minA = a best = p end
                    end
                end
            end
        end
    end
    return best
end

local function SolveAimDirection(o, t, sp, g)
    local off = t - o
    local hor = Vector3.new(off.X, 0, off.Z)
    local dx = hor.Magnitude
    local dy = off.Y
    if off.Magnitude <= 0.001 then return nil end
    if dx <= 0.35 or g <= 0.001 then return off.Unit, math.clamp(off.Magnitude / sp, 0.025, 4) end
    local h = hor.Unit
    local dp = math.atan2(dy, dx)
    local minP = math.max(-Angle28Rad, dp - Angle18Rad)
    local maxP = Angle72Rad
    local bp, bs, bdy, bt = nil, math.huge, math.huge, nil
    for i = 0, 24 do
        local p = minP + (maxP - minP) * (i/24)
        local cp = math.cos(p)
        if cp > 0.015 then
            local tt = dx / (sp * cp)
            if tt == tt and tt > 0 and tt >= 0.025 and tt <= 4 then
                local y = sp * math.sin(p) * tt - 0.5 * g * tt * tt
                local dd = math.abs(y - dy)
                local sc = dd + math.max(p - Angle42Rad, 0) * 0.35 + math.max(tt - 1.3, 0) * 0.25
                if sc < bs then bs, bdy, bp, bt = sc, dd, p, tt if dd < MinTargetDiff then break end end
            end
        end
    end
    if not bp then
        local tt = math.clamp(dx / sp, 0.025, 4)
        local ap = t + Vector3.new(0, 0.5 * g * tt * tt, 0)
        local d = ap - o
        if d.Magnitude <= 0.001 then return nil end
        return d.Unit, tt
    end
    local dir = h * math.cos(bp) + Vector3.new(0, math.sin(bp), 0)
    if dir.Magnitude <= 0.001 then return nil end
    return dir.Unit, bt
end

local function OnRenderStepAim()
    CheatState.CV_frameCount = CheatState.CV_frameCount + 1
    if not CheatState.CV_Enabled then return end
    local hold = CheatState.CV_HoldingPC or CheatState.CV_HoldingMobile
    if not hold then
        if CheatState.CV_WasHolding then
            CheatState.CV_CurrentTarget = nil
            CheatState.CV_WasHolding = false
            CheatState.CV_LastStableDir = nil
            CheatState.CV_acquireStartFrame = nil
        end
        return
    end
    if not CheatState.CV_WasHolding then
        CheatState.CV_LastStableDir = nil
        CheatState.CV_CurrentTarget = GetClosestTarget()
        CheatState.CV_WasHolding = true
        CheatState.CV_acquireStartFrame = CheatState.CV_frameCount
    end
    local t = CheatState.CV_CurrentTarget
    if not t then CheatState.CV_WasHolding = false return end
    local ch = t.Character
    local h = ch and ch:FindFirstChildOfClass("Humanoid")
    if not ch or not h or h.Health <= 0 or GetPlayerRole(t) ~= "survivor" then
        CheatState.CV_WasHolding = false
        CheatState.CV_CurrentTarget = nil
        return
    end
    local pos = GetCharPos(ch)
    if not pos then CheatState.CV_WasHolding = false CheatState.CV_CurrentTarget = nil return end
    local cam = Workspace.CurrentCamera
    local my = LocalPlayer.Character
    local myR = my and my:FindFirstChild("HumanoidRootPart")
    if not cam or not myR then return end
    if (pos - myR.Position).Magnitude > Config.cameraVeilMaxDistance then
        CheatState.CV_WasHolding = false
        CheatState.CV_CurrentTarget = nil
        return
    end
    local vel = GetCharVel(ch:FindFirstChild("HumanoidRootPart"))
    local o = GetCameraOrigin()
    if not o then return end
    local sp = tonumber(CheatState.CV_LastSpearSpeed) or tonumber(Config.cameraVeilSpearSpeed) or 220
    sp = math.clamp(sp, 35, 800)
    local gm = math.max(tonumber(CheatState.CV_LastGravityMult) or 1, 0)
    local g = Workspace.Gravity * gm
    local dir, ft = SolveAimDirection(o, pos, sp, g)
    if dir and ft and vel.Magnitude > 1.25 then
        local ls = math.clamp(ft * 0.68, 0, 1.1)
        local lead = vel * ls
        if lead.Magnitude > 32 then lead = lead.Unit * 32 end
        local rf, rt = SolveAimDirection(o, pos + lead, sp, g)
        if rf then dir, ft = rf, rt end
    end
    local sd = dir
    if sd and sd.Y < 0.95 and sd.Y > -0.95 then
        if CheatState.CV_LastStableDir then
            local d = math.acos(math.clamp(CheatState.CV_LastStableDir:Dot(sd), -1, 1))
            if d < Angle45Rad then CheatState.CV_LastStableDir = sd end
        else
            CheatState.CV_LastStableDir = sd
        end
        sd = CheatState.CV_LastStableDir
    elseif CheatState.CV_LastStableDir then
        sd = CheatState.CV_LastStableDir
    else
        sd = cam.CFrame.LookVector
    end
    local cp = cam.CFrame.Position
    local sm = math.clamp(Config.cameraVeilSmoothness or 1, 0.05, 1)
    local nl = cam.CFrame.LookVector:Lerp(sd, sm)
    if nl.Magnitude > 0.001 then
        cam.CFrame = CFrame.new(cp, cp + nl.Unit)
    end
end

local function EnableCameraVeil()
    if CheatState.CV_Enabled then return end
    CheatState.CV_Enabled = true
    CheatState.CV_HoldingPC = false
